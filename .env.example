# ─────────────────────────────────────────────────────────────────────────────
# Py — Workflow Builder · environment variables
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Build attribution (REQUIRED by spec) — every page logs `[Py] Candidate LinkedIn: <url>`
NEXT_PUBLIC_CANDIDATE_LINKEDIN_URL="https://www.linkedin.com/in/your-handle"

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Where Clerk sends users (kept in sync with middleware/routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── Neon Postgres (Prisma) ───────────────────────────────────────────────────
# Pooled connection string for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for migrations. On Neon, use the -pooler-less host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Google Gemini ────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY="..."

# ── Trigger.dev (all node execution + realtime) ──────────────────────────────
TRIGGER_SECRET_KEY="tr_dev_..."
TRIGGER_PROJECT_ID="proj_..."
# Public access token can be minted server-side for Realtime; no static public key needed.

# ── Transloadit (image upload + crop assembly input) ─────────────────────────
TRANSLOADIT_KEY="..."
TRANSLOADIT_SECRET="..."
# Optional: a Template ID if you pre-create one in the Transloadit dashboard.
TRANSLOADIT_TEMPLATE_ID=""
